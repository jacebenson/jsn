{
  "name": "@jacebenson/jsn",
  "version": "5.6.1",
  "description": "A command-line interface for ServiceNow that follows the Unix philosophy: simple, composable, and scriptable.",
  "type": "module",
  "bin": {
    "jsn": "bin/jsn.js"
  },
  "main": "src/cli.js",
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:mutation": "npm exec --yes --package=@stryker-mutator/core@10.1.1 -- stryker run stryker.config.json",
    "test:pty": "node --test test/pty/prompts-pty.test.js",
    "lint": "eslint src/ bin/ test/",
    "start": "node bin/jsn.js"
  },
  "keywords": [
    "servicenow",
    "cli",
    "rest-api",
    "automation"
  ],
  "author": "Jace Benson",
  "repository": "https://github.com/jacebenson/jsn",
  "license": "MIT",
  "dependencies": {
    "commonmark": "^0.31.2",
    "js-yaml": "^5.5.0",
    "saxes": "^6.0.0",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.6.0"
  },
  "files": [
    "bin/jsn.js",
    "src/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
