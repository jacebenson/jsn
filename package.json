{
  "name": "@jacebenson/jsn",
  "version": "4.1.1",
  "description": "A command-line interface for ServiceNow that follows the Unix philosophy: simple, composable, and scriptable.",
  "type": "module",
  "bin": {
    "jsn": "bin/jsn.js"
  },
  "main": "src/cli.js",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test $(find test -name '*.test.js')",
    "lint": "npx eslint src/ bin/ test/",
    "start": "node bin/jsn.js",
    "docs": "npm --prefix docs run build",
    "docs:serve": "npm --prefix docs run serve",
    "tag-reminder": "node scripts/tag-reminder.js",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "servicenow",
    "cli",
    "rest-api",
    "automation"
  ],
  "author": "Jace Benson",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@inquirer/core": "^10.1.0",
    "@inquirer/prompts": "^7.5.1",
    "better-sqlite3": "^13.0.3",
    "gray-matter": "^4.0.3",
    "turndown": "^7.2.4",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inquirer/search": "^4.2.1",
    "globals": "^17.6.0"
  },
  "files": [
    "bin/jsn.js",
    "src/",
    "skills/",
    "scripts/",
    "README.md",
    "LICENSE"
  ]
}
