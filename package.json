{
  "name": "@jacebenson/jsn",
  "version": "4.5.0",
  "description": "A command-line interface for ServiceNow that follows the Unix philosophy: simple, composable, and scriptable.",
  "type": "module",
  "bin": {
    "jsn": "bin/jsn.js"
  },
  "main": "src/cli.js",
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:mutation": "stryker run",
    "lint": "npx eslint src/ bin/ test/",
    "start": "node bin/jsn.js",
    "docs": "npm --prefix docs run build",
    "docs:serve": "npm --prefix docs run serve"
  },
  "keywords": [
    "servicenow",
    "cli",
    "rest-api",
    "automation"
  ],
  "author": "Jace Benson",
  "repository": "https://github.com/jacebenson/jsn",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^5.5.0",
    "saxes": "^6.0.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "globals": "^17.6.0"
  },
  "files": [
    "bin/jsn.js",
    "src/",
    "skills/",
    "README.md",
    "LICENSE"
  ]
}
