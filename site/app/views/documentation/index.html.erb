<% content_for :title, "Search documentation · JSN" %>
<section class="shell detail docs-search <%= "has-results" if @query.present? %>"><p class="eyebrow">THE SERVICENOW DOCUMENTATION LIBRARY</p><h1>Find the answer.<br><em>Get back to building.</em></h1><p class="lead">Search the documentation here. No installation, database download, or account needed.</p><%= form_with url: '/documentation', method: :get, class: 'docs-query' do |f| %><%= f.label :q, 'What are you working on?' %><div class="video-input"><%= f.search_field :q, value: @query, placeholder: 'Try GlideRecord, business rules, or REST APIs', maxlength: 200, required: true %><%= f.submit 'Search docs →', class: 'button' %></div><% end %><p class="small">Source: ServiceNow’s public documentation · <%= ENV.fetch('DOCS_SOURCE_BRANCH', 'australia').humanize %> release · refreshed daily when the sync worker is running.</p><% if @status['documents'] %><p class="small"><%= number_with_delimiter(@status['documents']) %> documents indexed · Last published <%= documentation_timestamp(@status['publishedAt']) %></p><% end %><% if @error %><p class="error" role="alert"><%= @error %></p><% end %><% if @search %><h2><%= number_with_delimiter(@search[:total]) %> results for “<%= @query %>”</h2><% if @search[:results].empty? %><p>No matches yet. Try fewer words or a different term.</p><% end %><% @search[:results].each do |doc| %><article class="search-result"><p class="eyebrow"><%= documentation_category(doc) %><% if doc['doc_type'].present? %> / <%= doc['doc_type'] %><% end %></p><h2><%= link_to doc['title'].presence || doc['path'], '/documentation/read?' + { path: doc['path'] }.to_query %></h2><p><%= documentation_summary_highlight(doc['summary'], @query) %></p></article><% end %><nav class="actions" aria-label="Search results pages"><% if @search[:offset] > 0 %><%= link_to '← Previous', '/documentation?' + { q: @query, offset: [@search[:offset] - 20, 0].max }.to_query %><% end %><% if @search[:offset] + 20 < @search[:total] && @search[:offset] < 10_000 %><%= link_to 'Next results →', '/documentation?' + { q: @query, offset: @search[:offset] + 20 }.to_query %><% end %></nav><% else %><div class="suggestions"><h2>A few places to start.</h2><% ['GlideRecord', 'business rules', 'script include', 'REST API'].each do |term| %><%= link_to term + ' ↗', '/documentation?' + { q: term }.to_query, class: 'suggestion' %><% end %></div><% end %><details class="api-guide"><summary>Using an agent or building an integration?</summary><p>The same documentation is available through the public REST API.</p><pre>GET /api/docs/search?q=GlideRecord&amp;limit=20
GET /api/docs/document?path=…
GET /api/docs/:id?revision=…</pre><p>Search returns document paths, IDs, snippets, and an index revision. Read by path for a stable reference; numeric IDs should be used with the returned revision. Document bodies are Markdown.</p></details></section>
