<section class="auth"><p class="eyebrow">WELCOME BACK</p><h1>Right where<br>you left off.</h1><p>Log in to manage videos and documentation publishing.</p><% if @error %><p class="error" role="alert"><%= @error %></p><% end %><%= form_with url: login_path do |form| %><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: 'email' %><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: 'current-password' %><%= form.submit 'Log in →', class: 'button' %><% end %><p>Documentation search and feature videos are public. No account needed.</p></section>
