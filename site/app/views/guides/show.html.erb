<% content_for :title, "#{@guide.title} · JSN" %>
<link rel="stylesheet" href="/guide.css">
<div class="shell guide-grid"><aside><a class="eyebrow" href="/docs/">JSN GUIDES</a><nav aria-label="Guide navigation"><% @guides.each do |guide| %><a href="<%= guide.url %>" <%= 'aria-current=page' if guide.slug == @guide.slug %>><%= guide.title %></a><% end %></nav><p class="guide-note">Maintained in docs/<%= MarkdownGuide::SOURCES.fetch(@guide.slug) %>.</p></aside>
<article class="guide-article"><header><p class="eyebrow">THE JSN HANDBOOK</p><h1><%= @guide.title %></h1><p class="guide-subtitle"><%= @guide.metadata['subtitle'] %></p></header><div class="guide-body"><%= @guide.html %></div><nav class="guide-pager" aria-label="Next and previous guides"><% ['docPrev', 'docNext'].each do |key| %><% target = MarkdownGuide.safe_link(@guide.metadata[key].to_s, @guide.slug) %><% if target %><a href="<%= target %>"><%= @guide.metadata["#{key}Label"] %></a><% end %><% end %></nav></article></div>
