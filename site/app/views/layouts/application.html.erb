<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= content_for?(:title) ? yield(:title) : "JSN · A little less clicking." %></title><%= csrf_meta_tags %><link rel="stylesheet" href="/site.css"></head>
