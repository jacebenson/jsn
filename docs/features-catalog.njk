---
permalink: "/features/"
title: Every JSN feature
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Every JSN feature</title>
  <meta name="description" content="Every capability in the JSN ServiceNow CLI, with commands and terminal output.">
  <style>
    :root { --ink:#171717; --paper:#f4f1ea; --paper2:#e8e3d8; --yellow:#f4b400; --red:#b83a2d; --muted:#68645c; --line:#c9c2b5; --terminal:#17191a; --terminal-fg:#dedbd2; }
    *{box-sizing:border-box} body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 system-ui,-apple-system,sans-serif}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    header{display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--line)}.brand{font:800 1rem monospace;text-decoration:none}.brand span{color:var(--red)}nav{display:flex;gap:18px;font:13px monospace}nav a{text-decoration:none}nav a:hover{color:var(--red)}
    .intro{padding:80px 0 60px;max-width:800px}.kicker{color:var(--red);font:700 12px monospace;letter-spacing:.12em;text-transform:uppercase}.intro h1{margin:14px 0;font:800 clamp(3rem,7vw,6.5rem)/.88 system-ui,sans-serif;letter-spacing:-.095em}.intro p{max-width:650px;color:var(--muted);font-size:1.15rem}.count{display:inline-block;margin-top:16px;padding:8px 11px;background:var(--yellow);font:700 12px monospace}
    .catalog{display:block;padding-bottom:80px}.card{display:flex;flex-direction:column;min-height:360px;padding:24px;background:var(--paper2);border:1px solid var(--line)}.card:nth-child(3n+2){background:#dfe7e9}.card:nth-child(3n+3){background:#eee0d5}.number{color:var(--red);font:700 12px monospace}.card h2{margin:10px 0 8px;font:800 1.8rem/1 monospace;letter-spacing:-.07em}.tagline{min-height:48px;margin:0;color:#555149}.commands{margin-top:22px;display:grid;gap:7px}.command{display:block;padding:9px 10px;background:#fff8;border:1px solid #c7bfae;color:var(--red);font:12px monospace;overflow:auto;white-space:nowrap}.preview{margin-top:auto;padding-top:20px}.preview summary{cursor:pointer;color:var(--ink);font:700 12px monospace}.preview pre{max-height:150px;overflow:auto;padding:13px;margin:10px 0 0;background:var(--terminal);color:var(--terminal-fg);font:11px/1.5 monospace;white-space:pre-wrap}.open{display:inline-block;margin-top:17px;color:var(--ink);font:700 12px monospace;text-decoration:underline;text-underline-offset:4px}
    .feature-layout{display:grid;grid-template-columns:180px minmax(0,1fr);gap:34px;align-items:start}.toc{position:sticky;top:24px;padding:14px 0;border-top:2px solid var(--red)}.toc-label{margin-bottom:10px;color:var(--muted);font:700 11px monospace;letter-spacing:.1em;text-transform:uppercase}.toc nav{display:grid;gap:3px}.toc a{display:flex;justify-content:space-between;gap:8px;padding:9px 8px;color:var(--ink);font:700 12px monospace;text-decoration:none;border-left:2px solid transparent}.toc a span{color:var(--muted)}.toc a:hover,.toc a:focus-visible{background:#20262d;color:var(--yellow);border-left-color:var(--yellow)}.toc a:hover span,.toc a:focus-visible span{color:var(--yellow)}
    .feature-group{margin:0 0 56px}.group-heading{display:flex;align-items:baseline;gap:14px;margin:0 0 18px;border-bottom:1px solid var(--line);padding-bottom:10px}.group-heading span{color:var(--red);font:700 12px monospace}.group-heading h2{margin:0;font:800 2.2rem/1 system-ui,sans-serif;letter-spacing:-.06em}.group-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.card h3{margin:10px 0 8px;font:800 1.45rem/1.05 monospace;letter-spacing:-.05em}
    body{overflow-x:hidden}.card{min-height:0;padding:20px}.card h3{font-size:1.25rem;line-height:1.15}.tagline{min-height:0}.commands{margin-top:18px;display:grid;gap:8px}.feature-details{border-top:1px solid var(--line);padding:9px 0}.feature-details summary{cursor:pointer;color:var(--yellow);font:700 12px monospace;list-style:none}.feature-details summary::-webkit-details-marker{display:none}.feature-details summary:before{content:'+ ';color:var(--muted)}.feature-details[open] summary:before{content:'− ';color:var(--yellow)}.command-list{display:grid;gap:10px;margin-top:10px}.command-row{display:grid;gap:4px;padding:9px;background:#20262d;border-left:2px solid var(--line)}.command-row span{color:var(--muted);font-size:.85rem}.command{display:block;max-width:100%;padding:0;background:transparent;border:0;color:var(--yellow);font:12px/1.5 monospace;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}.preview-output{margin-top:10px;max-width:100%;overflow:hidden}.preview-output pre{max-height:220px;overflow:auto;padding:12px;margin:0;background:var(--terminal);color:var(--terminal-fg);font:11px/1.5 monospace;white-space:pre-wrap;overflow-wrap:anywhere}.open{margin-top:14px}
    .feature-group{margin:0 0 56px}.group-heading{display:flex;align-items:baseline;gap:14px;margin:0 0 18px;border-bottom:1px solid var(--line);padding-bottom:10px}.group-heading span{color:var(--red);font:700 12px monospace}.group-heading h2{margin:0;font:800 2.2rem/1 system-ui,sans-serif;letter-spacing:-.06em}.group-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    footer{display:flex;justify-content:space-between;padding:26px 0;border-top:1px solid var(--line);color:var(--muted);font:12px monospace}@media(max-width:850px){.feature-layout{grid-template-columns:1fr}.toc{position:static;padding:12px 0;border-bottom:1px solid var(--line);border-top:0}.toc nav{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px}.toc a{flex:0 0 auto;border-left:0;border-bottom:2px solid transparent;white-space:nowrap}.toc a:hover,.toc a:focus-visible{border-left:0;border-bottom-color:var(--yellow)}.group-grid{grid-template-columns:1fr}.intro{padding-top:50px}nav a:not(:last-child){display:none}}
  </style>
  <link rel="stylesheet" href="/css/omarchy.css">
</head>
<body><div class="wrap">
  <header><a class="brand" href="/">j<span>sn</span></a><nav><a href="/">Home</a><a href="/docs/install/">Docs</a><a href="https://github.com/jacebenson/jsn">GitHub</a></nav></header>
  <main><section class="intro"><div class="kicker">The complete command surface</div><h1>Every feature.<br>No treasure hunt.</h1><p>The homepage shows the few workflows worth leading with. This page shows the whole thing: core records, diagnostics, developer tools, agent support, and the commands behind each one.</p><div class="count">{{ showcases | length }} capabilities · command examples · terminal output</div></section>
  <div class="feature-layout">
    <aside class="toc" aria-label="Feature sections"><div class="toc-label">On this page</div><nav>{% for group in featureGroups %}<a href="#group-{{ loop.index }}">{{ group.name }} <span>{{ group.features | length }}</span></a>{% endfor %}</nav></aside>
    <section class="catalog" aria-label="Every JSN feature">
  {% for group in featureGroups %}<section class="feature-group" id="group-{{ loop.index }}"><div class="group-heading"><span>{{ loop.index | string }}</span><h2>{{ group.name }}</h2></div><div class="group-grid">{% for s in group.features %}<article class="card"><div class="number">{{ loop.index }}</div><h3>{{ s.seoTitle }}</h3><p class="tagline">{{ s.seoDescription }}</p><div class="commands"><details class="feature-details"><summary>{{ s.commands | length }} command{% if s.commands | length != 1 %}s{% endif %}</summary><div class="command-list">{% for c in s.commands %}<div class="command-row"><code class="command">{{ c.cmd }}</code><span>{{ c.what }}</span></div>{% endfor %}</div></details>{% if s.screens or s.demoText %}<details class="feature-details"><summary>Preview terminal output</summary><div class="preview-output">{% if s.screens %}<pre>{{ s.screens[0].text | stripPrompt }}</pre>{% else %}<pre>{{ s.demoText | stripPrompt }}</pre>{% endif %}</div></details>{% endif %}</div><a class="open" href="/features/{{ s.canonicalSlug }}/">Open feature →</a></article>{% endfor %}</div></section>{% endfor %}
    </section>
  </div></main>
  <footer><span>JSN · ServiceNow CLI</span><span><a href="/">Back to home</a></span></footer>
</div></body></html>
