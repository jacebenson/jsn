    :root { --ink:#f4f1ea; --paper:#121212; --paper2:#1e1e1e; --yellow:#f4b400; --red:#ff7b6d; --blue:#204e70; --muted:#aaa49a; --line:#3b3935; --terminal:#080909; --terminal-fg:#dedbd2; --green:#83d49b; --om-paper:#121212; --om-paper-2:#1e1e1e; --om-ink:#f4f1ea; --om-muted:#aaa49a; --om-line:#3b3935; --om-red:#ff7b6d; }
