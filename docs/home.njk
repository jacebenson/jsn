    .actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:30px; }.button{display:inline-block;padding:13px 17px;border-radius:3px;text-decoration:none;font-weight:750}.primary{background:var(--red);color:#fff}.secondary{border:1px solid var(--ink)}
