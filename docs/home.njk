    .term-top { display:flex; gap:7px; padding:12px 15px; border-bottom:1px solid #343638; color:#777; font:12px monospace; }.dot{width:9px;height:9px;border-radius:50%;background:#555}.dot.r{background:#e85b4e}.dot.y{background:#e7b63e}.dot.g{background:#65be78}.term-body{padding:22px;min-height:325px;font:13px/1.7 monospace;white-space:pre-wrap}.prompt{color:var(--yellow)}.good{color:var(--green)}.fade{color:#777}
