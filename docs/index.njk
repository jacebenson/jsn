---
title: JSN - ServiceNow CLI
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ site.description | truncate(160) }}">
    <link rel="canonical" href="{{ site.url }}/">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ site.description | truncate(160) }}">
    <meta property="og:url" content="{{ site.url }}/">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="hero">
            <h1>Agent-first, agent-native<span class="cursor"></span></h1>
            <p class="tagline">The ServiceNow REST API, plus the context that matters.<br>Catalog variables, flow subflows, related records. Works standalone or with any AI agent.</p>
            <p style="text-align: center; margin-top: 1rem;">
                <a href="https://github.com/jacebenson/jsn" style="color: var(--accent); font-size: 1rem; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; padding: 0.5rem 1.2rem; border: 1px solid var(--accent); border-radius: 6px;">
                    <svg height="18" width="18" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                    View on GitHub
                </a>
            </p>
            <p style="text-align: center; margin-top: 0.75rem;">
                <a href="/features/" style="color: var(--fg); font-size: 0.95rem; text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 2px;">Every feature, shown →</a>
            </p>
            
            <div class="install">
                <code>npm install -g @jacebenson/jsn</code>
                <button class="copy-btn" onclick="copyNpmInstall()">Copy</button>
            </div>
            <p style="text-align: center; font-size: 0.85rem; margin-top: -1rem;">
                <span style="color: var(--muted);">Cross-platform · Works on Windows, macOS, Linux · Requires Node.js</span>
            </p>



            <div style="background: rgba(255, 193, 7, 0.05); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-top: 1.5rem; font-size: 0.85rem; text-align: left;">
            <strong style="color: var(--accent);">Requirements</strong>
            <ul style="margin: 0.5rem 0 0 1.2rem; color: var(--muted); line-height: 1.8;">
                <li><strong>Node.js</strong> required — that is the only runtime dependency</li>
                <li><strong>Install:</strong> <code style="color: var(--accent);">npm install -g @jacebenson/jsn</code> — works on Windows, macOS, Linux</li>
                <li><strong>AI Agents:</strong> <code style="color: var(--accent);">jsn skill install</code> after auth</li>
            </ul>
            </div>

            <details style="margin-top: 0.75rem; text-align: left; font-size: 0.85rem; color: var(--muted); cursor: pointer;">
                <summary style="color: var(--muted); font-size: 0.85rem;">Don't have Node.js?</summary>
                <p style="margin-top: 0.5rem; line-height: 1.6;">
                    Install Node.js and npm from the official site:<br>
                    <a href="https://nodejs.org" target="_blank" style="color: var(--accent);">nodejs.org</a>
                </p>
                <p style="margin-top: 0.5rem; line-height: 1.6;">
                    Or use a version manager:<br>
                    <code style="font-size: 0.8rem;">brew install node</code> (macOS) ·
                    <code style="font-size: 0.8rem;">sudo apt install nodejs npm</code> (Ubuntu/Debian) ·
                    <a href="https://github.com/nvm-sh/nvm" target="_blank" style="color: var(--accent);">nvm</a> (all platforms)
                </p>
            </details>
        </header>

        <h2 style="color: var(--accent); font-size: 1.1rem; margin-bottom: 1rem; font-family: 'SF Mono', Monaco, monospace; text-align: center;">What it looks like</h2>

        <section class="showcase">
            <div class="pills">
                {% for s in showcases %}
                <button class="pill{% if loop.first %} active{% endif %}" data-target="demo-{{ s.id }}">{{ s.title }}</button>
                {% endfor %}
            </div>
            <div class="screen">
                {% for s in showcases %}
                <div class="pane{% if loop.first %} active{% endif %}" id="demo-{{ s.id }}">
                    <div class="pane-bar"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span><span class="pane-cmd">$ {{ s.commands[0].cmd | cmdName }}</span></div>
                    {% if s.screens %}
                    <div class="carousel" data-carousel>
                        <div class="cdots">{% for sc in s.screens %}<button class="cdot{% if loop.first %} active{% endif %}" data-i="{{ loop.index0 }}" aria-label="Screen {{ loop.index }}"></button>{% endfor %}</div>
                        {% for sc in s.screens %}
                        <div class="cscreen{% if loop.first %} active{% endif %}"><pre><span class="cmdline">$ {{ sc.cmd | wrapCmd }}</span>

{{ sc.text }}</pre></div>
                        {% endfor %}
                    </div>
                    {% if s.screenshots %}
                    {% for sh in s.screenshots %}
                    <div class="feat-shot"><img src="{{ sh.src }}" alt="{{ sh.alt }}"></div>
                    {% endfor %}
                    {% endif %}
                    {% else %}
                    <pre><span class="cmdline">$ {{ s.commands[0].cmd | wrapCmd }}</span>

{{ s.demoText }}</pre>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>

        <script>
        (function () {
            const pills = document.querySelectorAll('.showcase .pill');
            const panes = document.querySelectorAll('.showcase .pane');
            let timers = {};

            function stopCarousel(id) { if (timers[id]) { clearInterval(timers[id]); delete timers[id]; } }

            function startCarousel(pane) {
                const car = pane.querySelector('[data-carousel]');
                if (!car) return;
                const screens = car.querySelectorAll('.cscreen');
                const dots = car.querySelectorAll('.cdot');
                let i = 0;
                function show(n) {
                    i = (n + screens.length) % screens.length;
                    screens.forEach((s, k) => s.classList.toggle('active', k === i));
                    dots.forEach((d, k) => d.classList.toggle('active', k === i));
                }
                dots.forEach((d) => d.addEventListener('click', () => show(parseInt(d.dataset.i, 10))));
                stopCarousel(pane.id);
                timers[pane.id] = setInterval(() => show(i + 1), 2600);
            }

            pills.forEach((pill) => {
                pill.addEventListener('click', () => {
                    pills.forEach((p) => p.classList.remove('active'));
                    panes.forEach((p) => { p.classList.remove('active'); stopCarousel(p.id); });
                    pill.classList.add('active');
                    const pane = document.getElementById(pill.dataset.target);
                    pane.classList.add('active');
                    startCarousel(pane);
                });
            });
            // start the first pane's carousel if it has one
            const first = document.querySelector('.showcase .pane.active');
            if (first) startCarousel(first);
        })();
        </script>

        <section class="why" style="margin: 3rem 0; text-align: center;">
            <h2 style="color: var(--accent); font-size: 1.1rem; margin-bottom: 1rem; font-family: 'SF Mono', Monaco, monospace;">Why jsn exists</h2>
            <p style="color: var(--muted); max-width: 640px; margin: 0 auto; line-height: 1.8;">
                When I started this in March 2026, the ServiceNow SDK couldn't read a record from a live instance. It could only build. So I built what I wanted: a CLI that works with your data across scopes.
            </p>
            <p style="color: var(--muted); max-width: 640px; margin: 0.75rem auto 0; line-height: 1.8;">
                now-sdk added live queries in June 2026. Good for them. But reading records was never the whole point.
            </p>
        </section>

        <section class="features">
            <h2 style="color: var(--accent); font-size: 1.1rem; margin-bottom: 1.5rem; font-family: 'SF Mono', Monaco, monospace; text-align: center; grid-column: 1 / -1;">What it does that plain REST doesn't</h2>

            <div class="feature">
                <h3>Context, not just REST</h3>
                <p>Load a catalog item and get its variables. Load a flow and get its subflows. Related records, resolved. Plain REST doesn't do that.</p>
            </div>

            <div class="feature">
                <h3>Agent-Native</h3>
                <p>JSON output and breadcrumbs for agents. Works with Hermes, Claude, Codex, Cursor, OpenCode, Copilot. The skill is a markdown file, no MCP server to stand up. CLIs run on a fraction of the context MCP servers eat (<a href="https://layered.dev/mcp-tool-schema-bloat-the-hidden-token-tax-and-how-to-fix-it/" target="_blank" style="color: var(--accent);">why</a>), and even the protocol's own repo admits the bloat problem (<a href="https://github.com/modelcontextprotocol/modelcontextprotocol/discussions/2036" target="_blank" style="color: var(--accent);">discussion #2036</a>).</p>
                <div class="code-block">
                    <span class="cmd">jsn incidents list --json</span> <span class="comment"># Structured output</span><br>
                    <span class="cmd">jsn skill install</span> <span class="comment"># Expert knowledge for your agent</span>
                </div>
            </div>

            <div class="feature">
                <h3>The docs, local</h3>
                <p>All ~50,000 ServiceNow docs, indexed, searchable instantly, offline. Ask the difference between Flow Designer and Playbooks and get an answer from the docs, not a guess.</p>
            </div>

            <div class="feature">
                <h3>Auth that just works</h3>
                <p>OAuth handled. The part raw AI plus REST keeps tripping on.</p>
            </div>

            <div class="feature">
                <h3>Safe by default</h3>
                <p>Read-only by default. Deletes are blocked unless you pass --force. You can even mark a profile read-only and mutations are blocked entirely.</p>
            </div>

            <div class="feature">
                <h3>Small by design</h3>
                <p>They declare 3 dependencies. You end up with 628 packages and 353 MB. We declare 6. You end up with 90 and 41 MB. None of ours are abandoned. Three of theirs are.</p>
            </div>
        </section>

        <section style="text-align: center; padding: 2rem 0;">
            <p style="color: var(--muted);">
                Install: <code style="color: var(--accent);">npm install -g @jacebenson/jsn</code> · Auth: <code style="color: var(--accent);">jsn setup</code> · Agents: <code style="color: var(--accent);">jsn skill install</code>
            </p>
            <p style="margin-top: 1rem;">
                <a href="https://github.com/jacebenson/jsn/blob/nodejs/skills/servicenow/SKILL.md" style="color: var(--accent); text-decoration: none;">Full setup guide &amp; skill docs →</a>
            </p>
        </section>

        <section style="text-align: center; padding: 2rem 0; border-top: 1px solid var(--border); margin-top: 3rem;">
            <p style="color: var(--muted); font-size: 0.95rem;">Open source, MIT. Runs locally. No analytics, nothing phones home. Credentials stay in your config.</p>
            <p style="color: var(--muted-dim, var(--muted)); font-size: 0.8rem; margin-top: 1.2rem;">Iron sharpens iron — inspired by <a href="https://github.com/ServiceNow/sdk" style="color: var(--accent);">now-sdk</a>, <a href="https://github.com/tehubersheezy/servicenow-cli" style="color: var(--accent);">sn (Rust)</a>, <a href="https://github.com/dpekez/snowTUI" style="color: var(--accent);">snowTUI</a>, <a href="https://github.com/sonisoft-cnanda/now-sdk-ext-mcp" style="color: var(--accent);">Nanda's now-sdk-ext-mcp</a>, and <a href="https://www.npmjs.com/package/@onlyflows/servicenow-mcp" style="color: var(--accent);">@onlyflows/servicenow-mcp</a>.</p>
        </section>

        <footer class="footer">
            <a href="https://github.com/jacebenson/jsn" class="github-link">github.com/jacebenson/jsn</a>
            <p>Open source • MIT License</p>
        </footer>
    </div>

    <script>
        // Copy npm install command
        function copyNpmInstall() {
            const code = 'npm install -g @jacebenson/jsn';
            navigator.clipboard.writeText(code).then(() => {
                const btn = event.target;
                btn.textContent = 'Copied!';
                setTimeout(() => btn.textContent = 'Copy', 2000);
            }).catch(() => {
                // Fallback for browsers that don't support clipboard API
                const textarea = document.createElement('textarea');
                textarea.value = code;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                const btn = event.target;
                btn.textContent = 'Copied!';
                setTimeout(() => btn.textContent = 'Copy', 2000);
            });
        }

        // Copy a demo command
        function copyDemo(btn, cmd) {
            navigator.clipboard.writeText(cmd).then(() => {
                btn.textContent = 'Copied!';
                setTimeout(() => btn.textContent = 'Copy', 2000);
            }).catch(() => {
                const textarea = document.createElement('textarea');
                textarea.value = cmd;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                btn.textContent = 'Copied!';
                setTimeout(() => btn.textContent = 'Copy', 2000);
            });
        }
    </script>
</body>
</html>